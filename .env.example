# Copy to .env.local for local `vercel dev` testing. Never commit the real value.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash if unset. Try gemini-flash-lite-latest for a higher free-tier rate limit.
GEMINI_MODEL=gemini-2.5-flash
