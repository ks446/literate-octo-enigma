# Copy to .env.local for local `vercel dev` testing. Never commit the real value.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-flash-latest (a rolling alias to the current GA flash
# model) if unset. Try gemini-flash-lite-latest for a higher free-tier rate limit, or
# pin a dated model name (e.g. gemini-3.5-flash) if you need reproducible behavior.
GEMINI_MODEL=gemini-flash-latest
